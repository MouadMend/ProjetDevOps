pipeline{
	agent any

	stages{
		stage('PACKAGE'){
			steps{
				sh 'mvn -B -f backend/tomcat/config/pom.xml clean package'
				sh 'cd frontend && docker compose build'
				sh 'cd backend && docker compose build'
			}
		}
		stage('Docker Tag') {
            steps {
                sh 'docker tag apache:latest mouadmend/projetdevops:apache'
				sh 'docker tag tomcat:latest mouadmend/projetdevops:tomcat'
            }
        }
        stage('Docker Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'Dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push mouadmend/projetdevops:apache
						docker push mouadmend/projetdevops:tomcat
                    '''
                }
            }
            post {
                always {
                    sh 'docker logout || true'
                }
            }
        }
		stage('Deploy with Ansible') {
    		steps {
        		withCredentials([
            		usernamePassword(
                	credentialsId: 'Dockerhub',
                	usernameVariable: 'DOCKERHUB_USER',
                	passwordVariable: 'DOCKERHUB_TOKEN'
            		)
        		]) {


sh '''
    whoami
    ansible --version
    ansible-galaxy collection list community.docker
'''
					
					sh '''
                	set +x
                	cd ansible
					ansible-playbook -i inventory.ini playbook.yml
            		'''
        			}

    		}
		}

	}



}

